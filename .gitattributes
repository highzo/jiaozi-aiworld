# 统一换行：脚本和源码一律 LF。
# Windows 上检出成 CRLF 会让 scripts/*.sh 在 Linux/安卓上报
# "/usr/bin/env bash^M: bad interpreter" —— 这是个很容易踩的坑。
* text=auto eol=lf

*.sh    text eol=lf
*.py    text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.svg   text eol=lf

# 二进制
*.png   binary
*.jpg   binary
*.ico   binary
